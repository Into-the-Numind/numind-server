# Copy to /etc/numind-sandbox/sandboxd.env and fill values from the release
# evidence before enabling Sandbox on Prod. This file contains no secrets.

NUMIND_SANDBOX_BROKER_INSTANCE=numind-prod-sandbox-primary
NUMIND_SANDBOX_API_HOST_UID=1001
NUMIND_SANDBOX_IMAGE_DIGEST=ccr.ccs.tencentyun.com/youshunumind/sandbox-skill@sha256:REPLACE_WITH_64_HEX_DIGEST
NUMIND_SANDBOX_SECCOMP_SHA256=sha256:REPLACE_WITH_64_HEX_DIGEST

# Values generated by scripts/cicd/calculate-sandbox-capacity.sh.
NUMIND_SANDBOX_PARENT_MEMORY_MAX_BYTES=REPLACE_FROM_CAPACITY_JSON
NUMIND_SANDBOX_WORKLOAD_MEMORY_MAX_BYTES=REPLACE_FROM_CAPACITY_JSON
NUMIND_SANDBOX_WORKLOAD_MEMORY_HIGH_BYTES=REPLACE_FROM_CAPACITY_JSON
NUMIND_SANDBOX_WORKLOAD_MEMORY_RECOVERY_BYTES=REPLACE_FROM_CAPACITY_JSON
NUMIND_SANDBOX_WORKLOAD_MEMORY_SHED_BYTES=REPLACE_FROM_CAPACITY_JSON
NUMIND_SANDBOX_CONTROL_MEMORY_HIGH_BYTES=268435456
NUMIND_SANDBOX_CONTROL_MEMORY_MAX_BYTES=402653184
NUMIND_SANDBOX_PARENT_HEADROOM_BYTES=134217728

# Optional stable numeric IDs. Leave empty to let the host allocate them, but
# record the resulting numind-sandbox-api gid and feed it to prod server deploy
# as NUMIND_SANDBOX_BROKER_GID.
NUMIND_SANDBOX_USER_UID=
NUMIND_SANDBOX_GROUP_GID=
NUMIND_SANDBOX_API_GROUP_GID=
