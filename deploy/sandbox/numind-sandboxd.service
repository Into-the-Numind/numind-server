[Unit]
Description=Numind sandboxd constrained broker
Requires=opt-numind\x2dsandbox-data\x2droot.mount
After=opt-numind\x2dsandbox-data\x2droot.mount network-online.target
Wants=network-online.target

[Service]
Type=simple
User=numind-sandbox
Group=numind-sandbox
SupplementaryGroups=numind-sandbox-api
EnvironmentFile=/etc/numind-sandbox/sandboxd.env
ExecStart=/opt/numind-sandbox/bin/numind-sandboxd -config /etc/numind-sandbox/sandboxd.yaml
Restart=always
RestartSec=5s
TimeoutStopSec=320s
Slice=numind-sandbox-control.slice
UMask=0007
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/numind-sandbox/journal /opt/numind-sandbox/tmp /run/numind-sandbox /run/user/%U
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
