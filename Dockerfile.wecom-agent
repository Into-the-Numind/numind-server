# ===========================================
# WeCom Agent Service Dockerfile
# 企业微信会话存档拉取服务
# ===========================================

# Build Stage - 使用 bullseye 确保 glibc 兼容性
FROM golang:1.24-bullseye AS builder

WORKDIR /app

# 安装 CGO 编译所需依赖
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*


# 复制 SDK 头文件和库
# 注意: 你需要将 libWeWorkFinanceSdk.so 和头文件放入 lib/wecom-sdk/
COPY lib/wecom-sdk/ /usr/local/lib/wecom-sdk/
ENV CGO_CFLAGS="-I/usr/local/lib/wecom-sdk"
ENV CGO_LDFLAGS="-L/usr/local/lib/wecom-sdk -lWeWorkFinanceSdk"

# 复制 Go Modules
COPY go.mod go.sum ./
RUN go mod download

# 复制源码
COPY . .

# 编译 Agent 服务 (启用 CGO)
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 \
    go build -o wecom-agent ./cmd/wecom-agent

# ===========================================
# Runtime Stage - 轻量级运行环境
FROM debian:bullseye-slim

WORKDIR /app

# 安装运行时依赖
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl1.1 \
    && rm -rf /var/lib/apt/lists/*

# 复制编译产物
COPY --from=builder /app/wecom-agent /app/wecom-agent

# 复制 C++ 动态库到系统库目录
COPY --from=builder /usr/local/lib/wecom-sdk/libWeWorkFinanceSdk.so /usr/lib/libWeWorkFinanceSdk.so

# 刷新动态库缓存
RUN ldconfig

# 环境变量 (运行时通过 docker run -e 注入)
# WECOM_CORP_ID, WECOM_SECRET, WECOM_PRIVATE_KEY_PATH, MYSQL_DSN

# 健康检查 (可选，根据实际情况调整)
# HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
#     CMD curl -f http://localhost:8080/health || exit 1

# 启动命令
CMD ["/app/wecom-agent"]
