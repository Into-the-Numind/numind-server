# Example runtime secrets for /opt/numind/prod/secrets.env.
# Do not commit the real secrets.env file or real values.
# deploy-remote.sh expects KEY=value lines with no quotes.

NUMIND_JWT_SECRET=
NUMIND_DB_PASSWORD=
NUMIND_REDIS_PASSWORD=
NUMIND_WECHAT_APP_SECRET=
NUMIND_WECHAT_MCH_API_V3_KEY=
NUMIND_ALIPAY_PRIVATE_KEY=
NUMIND_VOLC_API_KEY=
NUMIND_COS_SECRET_ID=
NUMIND_COS_SECRET_KEY=
NUMIND_BAIDU_API_KEY=
NUMIND_BAIDU_SECRET_KEY=
NUMIND_ALI_ACCESS_KEY_ID=
NUMIND_ALI_ACCESS_KEY_SECRET=
NUMIND_ALI_API_KEY=
NUMIND_ALI_IMAGE_API_KEY=
NUMIND_ALI_STABLE_DIFFUSION_API_KEY=
NUMIND_ALI_VISION_API_KEY=
NUMIND_ALI_DASHVECTOR_API_KEY=
NUMIND_LANGFUSE_SECRET_KEY=
NUMIND_AIHUBMIX_API_KEY=

# Prod rollout feature switches. Values are runtime env overrides for Viper
# keys such as features.notification_center.enabled.
NUMIND_FEATURES_NOTIFICATION_CENTER_ENABLED=
NUMIND_FEATURES_DOCUMENT_SYSTEM_ENABLED=
NUMIND_FEATURES_MEETING_COPILOT_ENABLED=
NUMIND_FEATURES_MEETING_DIARIZATION_ENABLED=
NUMIND_FEATURES_CHATBOT_QUERY_REWRITE_ENABLED=
NUMIND_FEATURES_RAG_EVAL_ENABLED=
NUMIND_FEATURES_UNIVERSAL_REWRITER_ENABLED=
NUMIND_FEATURES_ANSWERABILITY_GATE_ENABLED=
NUMIND_FEATURES_STRUCTURE_AWARE_CHUNKING_ENABLED=
NUMIND_FEATURES_HYBRID_RETRIEVAL_ENABLED=
NUMIND_FEATURES_RERANK_HARDENING_ENABLED=
NUMIND_FEATURES_KB_FALLBACK_ENABLED=
NUMIND_FEATURES_DOC2QUERY_ENABLED=
NUMIND_FEATURES_PROVIDER_PROMPT_CACHE_ENABLED=

# Agent web search.
NUMIND_WEB_SEARCH_TAVILY_API_KEY=
NUMIND_WEB_SEARCH_TAVILY_BASE_URL=
NUMIND_WEB_SEARCH_TAVILY_TIMEOUT_SECONDS=

# Agent/document generated files. Must be a persistent prod host directory.
NUMIND_AGENT_ARTIFACT_DIR=

# Feishu personal workspace: strict one-line JSON array; see
# docs/deployment/feishu-personal-workspace-runtime-config.md. Keep empty until
# the feature flag is deliberately enabled; never commit a real key.
NUMIND_SECURITY_THIRDPARTY_TOKEN_KEY=
NUMIND_FEISHU_KEYRING=
NUMIND_FEISHU_KEY_VERSION=
NUMIND_FEISHU_HOME_BASE=
NUMIND_FEISHU_RUNTIME_BASE=
NUMIND_FEISHU_AUTH_OWNER=
NUMIND_FEATURES_FEISHU_INTEGRATION_ENABLED=
