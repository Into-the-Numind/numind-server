# =============================================================================
# Layer 1: base — Debian Slim + Python 3.11 + system-level dependencies
#
# Tag: ccr.ccs.tencentyun.com/youshunumind/sandbox-skill:base-v1.5.0
#
# This layer changes rarely (only when new apt dependencies are needed).
# All skill-specific Python libraries are in Dockerfile.libs (Layer 2).
#
# Build:
#   docker build -f Dockerfile.base -t ccr.ccs.tencentyun.com/youshunumind/sandbox-skill:base-v1.5.0 .
# =============================================================================

# Pin to bookworm (Debian 12 stable). The unqualified python:3.11-slim now
# floats to trixie (Debian 13), where libpango1.0-0 was renamed (→ libpango-1.0-0)
# and the apt install below fails with "Unable to locate package libpango1.0-0".
# Bookworm carries the exact package names used here and matches the main image's
# Debian base family.
FROM python:3.11-slim-bookworm AS base

# Use a China Debian mirror (Tsinghua TUNA) — the build server is in Chengdu and
# deb.debian.org routes internationally (downloads stall for minutes). Covers both
# the deb822 (.sources) and legacy (sources.list) layouts across base-image versions.
RUN set -eux; \
    sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g; s|security.debian.org|mirrors.tuna.tsinghua.edu.cn|g' \
        /etc/apt/sources.list.d/debian.sources 2>/dev/null || true; \
    sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g; s|security.debian.org|mirrors.tuna.tsinghua.edu.cn|g' \
        /etc/apt/sources.list 2>/dev/null || true

# System dependencies required by skills:
#   - libpango / libcairo / libgdk-pixbuf-2.0-0 / shared-mime-info: weasyprint (PDF from HTML)
#   - libffi-dev: cffi / cryptography builds
#   - fonts-wqy-zenhei: CJK font support for PDF/chart generation (T12/T15 decisions)
#   - curl: minimal network tool (sandbox is --network=none; here for image-build-time only)
#   - pandoc: document-system 导出 md→docx（pandoc -o out.docx）/ md→pdf（--pdf-engine=weasyprint，
#       复用已装 weasyprint + CJK 字体）。仅本 skill 镜像装，不影响主应用 Dockerfile/部署链路。
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpango1.0-0 \
        libcairo2 \
        libgdk-pixbuf-2.0-0 \
        libffi-dev \
        shared-mime-info \
        fonts-wqy-zenhei \
        pandoc \
    && rm -rf /var/lib/apt/lists/*

# Create the sandbox user (nobody at uid/gid 65534 on Alpine; use 1000:1000 on Debian).
# uid 1000 matches SandboxConfig.UserSpec default.
RUN groupadd -g 1000 sandboxuser && useradd -u 1000 -g 1000 -s /bin/false sandboxuser

# Prepare directory structure.
# /workdir — tmpfs mount point (from docker run --tmpfs).
# /input   — injected input files (under /workdir at runtime).
# /output  — generated output files (under /workdir at runtime).
# /skills  — bind-mounted skill directories (read-only at runtime).
RUN mkdir -p /workdir /input /output /skills && \
    chown sandboxuser:sandboxuser /workdir /input /output

USER sandboxuser
WORKDIR /workdir
