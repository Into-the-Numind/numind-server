# =============================================================================
# Layer 2: libs — All skill Python dependencies pre-installed
#
# Tag: ccr.ccs.tencentyun.com/youshunumind/sandbox-skill:libs-v1.5.0
#
# Rebuild when:
#   - A new skill requires a new Python package not in requirements.txt
#   - An existing dependency has a security patch
#
# Build:
#   docker build -f Dockerfile.libs \
#     --build-arg BASE_TAG=base-v1.5.0 \
#     -t ccr.ccs.tencentyun.com/youshunumind/sandbox-skill:libs-v1.5.0 .
# =============================================================================

ARG BASE_TAG=base-v1.5.0
FROM ccr.ccs.tencentyun.com/youshunumind/sandbox-skill:${BASE_TAG} AS libs

# Switch to root temporarily for pip install.
USER root

# Copy pinned requirements for reproducible builds (T13 decision).
COPY requirements.txt /tmp/requirements.txt

# Install all skill dependencies in one layer to minimise image size.
# --no-cache-dir: avoid pip's write cache (saves ~200 MB in the image).
# --no-deps: not used — dependencies of dependencies are needed.
# Tsinghua PyPI mirror: build server is in China; default PyPI stalls (same
# reason Dockerfile.base uses the TUNA Debian mirror and the main image uses
# Tsinghua pip).
RUN pip install --no-cache-dir \
        -i https://pypi.tuna.tsinghua.edu.cn/simple \
        --trusted-host pypi.tuna.tsinghua.edu.cn \
        -r /tmp/requirements.txt && \
    rm /tmp/requirements.txt

# Runtime env for the locked-down sandbox (--read-only rootfs, seccomp, pids-limit,
# cap-drop ALL, --network=none). Verified on dev 2026-05-29:
#  - OPENBLAS_NUM_THREADS/OMP_NUM_THREADS=1: numpy (via Pillow→python-pptx) pulls in
#    OpenBLAS, which tries to spawn 4 worker threads. The seccomp/pids hardening
#    blocks pthread_create ("Operation not permitted"); OpenBLAS then retries and
#    the import STALLS — long enough to blow a skill's runtime budget. Forcing
#    single-threaded BLAS makes the import fast and warning-free.
#  - HOME/MPLCONFIGDIR/XDG_CACHE_HOME under /workdir: /home/sandboxuser is on the
#    read-only rootfs, so matplotlib (.config) and fontconfig (.cache) fail to write
#    their caches. /workdir is the only writable mount (tmpfs), so point caches there.
ENV OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1 \
    HOME=/workdir \
    MPLCONFIGDIR=/workdir/.mplconfig \
    XDG_CACHE_HOME=/workdir/.cache

# Return to sandbox user.
USER sandboxuser
