# Numind Server 环境变量配置
# 这些变量会覆盖 config.yaml 中的配置

# 环境配置
ENVIRONMENT=development

# 服务器配置 (可选，会覆盖 config.yaml)
# NUMIND_SERVER_PORT=8000
# NUMIND_SERVER_READ_TIMEOUT=30s
# NUMIND_SERVER_WRITE_TIMEOUT=30s

# 数据库配置 (可选，会覆盖 config.yaml)
# NUMIND_DATABASE_HOST=localhost
# NUMIND_DATABASE_PORT=3306
# NUMIND_DATABASE_USER=numind
# NUMIND_DATABASE_PASSWORD=numindpass
# NUMIND_DATABASE_NAME=wxtw
# NUMIND_DATABASE_MAX_OPEN_CONNS=10
# NUMIND_DATABASE_MAX_IDLE_CONNS=5

# Redis 配置 (可选，会覆盖 config.yaml)
# NUMIND_REDIS_HOST=localhost
# NUMIND_REDIS_PORT=6379
# NUMIND_REDIS_PASSWORD=
# NUMIND_REDIS_DB=0
# NUMIND_REDIS_POOL_SIZE=10

# JWT 配置 (可选，会覆盖 config.yaml)
# NUMIND_JWT_SECRET=your-secret-key-change-this-in-production

# 微信小程序配置 (可选，会覆盖 config.yaml)
# NUMIND_WECHAT_APP_ID=your-wechat-app-id
# NUMIND_WECHAT_APP_SECRET=your-wechat-app-secret

# 对象存储配置 (可选，会覆盖 config.yaml)
# NUMIND_OSS_ENDPOINT=your-oss-endpoint
# NUMIND_OSS_ACCESS_KEY_ID=your-oss-access-key-id
# NUMIND_OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
# NUMIND_OSS_BUCKET_NAME=your-oss-bucket-name

# OpenAI 配置 (可选，会覆盖 config.yaml)
# NUMIND_OPENAI_API_KEY=your-openai-api-key
# NUMIND_OPENAI_BASE_URL=https://api.openai.com/v1
# NUMIND_OPENAI_TIMEOUT=30s
# NUMIND_OPENAI_MAX_RETRIES=3

# 日志配置 (可选，会覆盖 config.yaml)
# NUMIND_LOGGING_LEVEL=info
# NUMIND_LOGGING_FORMAT=json
# NUMIND_LOGGING_OUTPUT=stdout
# NUMIND_LOGGING_FILE_PATH=./logs/numind.log

# 安全配置 (可选，会覆盖 config.yaml)
# NUMIND_SECURITY_RATE_LIMIT_REQUESTS=100
# NUMIND_SECURITY_RATE_LIMIT_WINDOW=1m
# NUMIND_SECURITY_JWT_EXPIRE_HOURS=24

# 监控配置 (可选，会覆盖 config.yaml)
# NUMIND_MONITORING_ENABLED=true
# NUMIND_MONITORING_METRICS_PORT=9090

# 跨域配置 (可选，会覆盖 config.yaml)
# NUMIND_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://llm-soup.xyz,http://47.108.85.126
# NUMIND_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
# NUMIND_CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization
# NUMIND_CORS_ALLOW_CREDENTIALS=true
# NUMIND_CORS_MAX_AGE=12h

# 应用信息 (可选，会覆盖 config.yaml)
# NUMIND_APP_NAME=Numind Server
# NUMIND_APP_VERSION=1.0.0
# NUMIND_APP_DESCRIPTION=Numind API Server

# 注意：
# 1. 环境变量使用 NUMIND_ 前缀，对应 config.yaml 中的配置项
# 2. 配置项名称使用下划线分隔，如 NUMIND_DATABASE_HOST
# 3. 时间类型使用 Go 的时间格式，如 30s, 1m, 1h
# 4. 数组类型使用逗号分隔，如 NUMIND_CORS_ALLOWED_ORIGINS=url1,url2,url3
# 5. 布尔类型使用 true/false
# 6. 优先级：环境变量 > config.yaml 环境配置 > config.yaml 公共配置 