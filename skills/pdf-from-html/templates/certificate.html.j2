<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>{{ award_title }} — {{ recipient_name }}</title>
<style>
  /* ── Reset ── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  /* ── Page / Print rules ──
     renderer.py injects: @page { size: A4 landscape; margin: 2cm ... }
     Here we only add decorative overlay rules. */

  /* ── Certificate body ── */
  body {
    /* Fallback body font from renderer.py; here we override for certificate
       aesthetic — prefer a serif/kai face for ceremonial feel. */
    font-family: 'AR PL UKai CN', 'KaiTi', '楷体', 'WenQuanYi Zen Hei',
                 '微软雅黑', 'Microsoft YaHei', serif;
    background: #FFFDF7;
    color: #1A1A1A;
  }

  /* ── Outer decorative border ── */
  .cert-outer-border {
    border: 6px double #8B6914;
    padding: 0.6cm;
    height: calc(100vh - 0.5cm);
    /* Use display:table to allow vertical centering without flex/grid */
    display: table;
    width: 100%;
  }

  /* ── Inner content cell ── */
  .cert-inner {
    display: table-cell;
    vertical-align: middle;
    text-align: center;
    border: 2px solid #C8A84B;
    padding: 1cm 1.5cm;
  }

  /* ── Logo / Org mark ── */
  .cert-logo {
    max-height: 60px;
    max-width: 200px;
    margin-bottom: 0.8em;
  }

  /* ── Issuer name / org ── */
  .cert-issuer-org {
    font-size: 11pt;
    letter-spacing: 0.2em;
    color: #6B4F12;
    margin-bottom: 1.2em;
  }

  /* ── Title ribbon ── */
  .cert-title-ribbon {
    font-size: 28pt;
    font-weight: bold;
    letter-spacing: 0.4em;
    color: #8B1A1A;
    margin-bottom: 0.6em;
    line-height: 1.2;
  }

  /* ── Decorative rule ── */
  .cert-rule {
    border: none;
    border-top: 1px solid #C8A84B;
    width: 60%;
    margin: 0.5em auto;
  }

  /* ── Recipient ── */
  .cert-recipient-label {
    font-size: 11pt;
    color: #475569;
    margin-bottom: 0.15em;
    letter-spacing: 0.1em;
  }
  .cert-recipient-name {
    font-size: 22pt;
    font-weight: bold;
    color: #0F172A;
    letter-spacing: 0.25em;
    margin-bottom: 1em;
    border-bottom: 1px solid #C8A84B;
    padding-bottom: 0.3em;
    display: inline-block;
    min-width: 8em;
  }

  /* ── Description body ── */
  .cert-description {
    font-size: 11.5pt;
    line-height: 2;
    color: #334155;
    max-width: 80%;
    margin: 0 auto 1.5em auto;
  }

  /* ── Signature row ── */
  .cert-signature-row {
    display: table;
    width: 90%;
    margin: 1.5em auto 0 auto;
  }
  .cert-signature-cell {
    display: table-cell;
    vertical-align: bottom;
    width: 33%;
    text-align: center;
  }

  /* Issue date (centre slot) */
  .cert-date {
    font-size: 11pt;
    color: #1A1A1A;
    letter-spacing: 0.05em;
  }
  .cert-date-label {
    font-size: 9pt;
    color: #64748B;
    display: block;
    margin-bottom: 0.2em;
  }

  /* Issuer name / title (right slot) */
  .cert-issuer-name-block {
    border-top: 1px solid #C8A84B;
    padding-top: 0.3em;
    display: inline-block;
    min-width: 8em;
    text-align: center;
  }
  .cert-issuer-name { font-size: 12pt; font-weight: bold; }
  .cert-issuer-title { font-size: 9pt; color: #64748B; display: block; margin-top: 0.1em; }

  /* Seal image (left slot, optional) */
  .cert-seal { max-height: 70px; max-width: 70px; opacity: 0.85; }
</style>
</head>
<body>

<div class="cert-outer-border">
  <div class="cert-inner">

    <!-- Org logo (optional) -->
    {% if logo_path is defined and logo_path %}
    <div>
      <img class="cert-logo" src="{{ logo_path }}" alt="机构标志">
    </div>
    {% endif %}

    <!-- Issuing organisation name -->
    {% if issuer_org is defined and issuer_org %}
    <div class="cert-issuer-org">{{ issuer_org }}</div>
    {% endif %}

    <!-- Title -->
    <div class="cert-title-ribbon">{{ award_title }}</div>
    <hr class="cert-rule">

    <!-- "hereby certifies that" preamble -->
    <div class="cert-recipient-label">兹证明</div>

    <!-- Recipient name -->
    <div>
      <span class="cert-recipient-name">{{ recipient_name }}</span>
    </div>

    <!-- Description / citation -->
    <div class="cert-description">
      {{ description | safe }}
    </div>

    <!-- Signature row: seal | date | issuer -->
    <div class="cert-signature-row">

      <!-- Left: seal image (optional) -->
      <div class="cert-signature-cell">
        {% if seal_path is defined and seal_path %}
        <img class="cert-seal" src="{{ seal_path }}" alt="印章">
        {% endif %}
      </div>

      <!-- Centre: issue date -->
      <div class="cert-signature-cell">
        <div class="cert-date">
          <span class="cert-date-label">颁发日期</span>
          {{ issue_date | date_cn }}
        </div>
      </div>

      <!-- Right: issuer name + title -->
      <div class="cert-signature-cell">
        <div class="cert-issuer-name-block">
          <span class="cert-issuer-name">{{ issuer_name }}</span>
          {% if issuer_title is defined and issuer_title %}
          <span class="cert-issuer-title">{{ issuer_title }}</span>
          {% endif %}
        </div>
      </div>

    </div><!-- /.cert-signature-row -->

  </div><!-- /.cert-inner -->
</div><!-- /.cert-outer-border -->

</body>
</html>
