# 外部构建阶段 - 用于 CI/CD 中使用预构建的二进制文件
FROM scratch AS external-binary
ARG BINARY_PATH
COPY $BINARY_PATH /app/numind-admin

# 运行阶段 - 基于 Ubuntu
FROM ubuntu:22.04

# 设置环境变量避免交互式安装
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

# 安装系统依赖
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 设置时区
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# 创建非 root 用户
RUN groupadd -g 1001 numind && useradd -u 1001 -g numind numind

# 设置工作目录
WORKDIR /app

# 定义构建参数，默认为dev环境
ARG ENV=dev

# 根据环境复制对应的配置文件
COPY config_${ENV}.yaml /app/config_${ENV}.yaml

# 根据构建参数选择二进制文件来源
ARG BINARY_SOURCE=external-binary
COPY --from=external-binary /app/numind-admin /app/numind-admin

# 验证配置文件复制成功
RUN ls -la /app/config_*.yaml && \
    echo "✅ 配置文件复制成功"

# 创建日志目录
RUN mkdir -p /app/logs && \
    chown -R numind:numind /app && \
    chmod -R 775 /app/logs && \
    chmod +x /app/numind-admin

# 切换到非 root 用户
USER numind

# 暴露端口（后台管理系统默认端口）
EXPOSE 9097

# 设置环境变量
ENV GIN_MODE=release
ENV PORT=9097
ENV TZ=Asia/Shanghai

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:9097/healthz || exit 1

# 创建启动脚本
RUN echo '#!/bin/bash\n\
# 根据环境变量选择配置文件\n\
if [ -n "$APP_ENV" ]; then\n\
    CONFIG_FILE="/app/config_${APP_ENV}.yaml"\n\
else\n\
    CONFIG_FILE="/app/config_dev.yaml"\n\
fi\n\
\n\
# 检查配置文件是否存在\n\
if [ ! -f "$CONFIG_FILE" ]; then\n\
    echo "错误: 配置文件不存在: $CONFIG_FILE"\n\
    echo "可用的配置文件:"\n\
    ls -la /app/config_*.yaml\n\
    exit 1\n\
fi\n\
\n\
echo "使用配置文件: $CONFIG_FILE"\n\
exec /app/numind-admin -c "$CONFIG_FILE" "$@"' > /app/start.sh && \
    chmod +x /app/start.sh

# 清理缓存和临时文件
RUN apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# 启动应用
ENTRYPOINT ["/app/start.sh"]
CMD []

